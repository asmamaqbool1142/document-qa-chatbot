# Copy to .env and adjust:  cp .env.example .env
# Never commit .env — it may contain API keys. It is listed in .gitignore.

# ---------------------------------------------------------------- general
LOG_LEVEL=INFO
DATA_DIR=data
# JSON list of origins allowed to call the API from a browser
CORS_ORIGINS=["http://localhost:8501"]
# Exposes GET /documents/{id}/chunks (returns raw document text). Keep false outside development.
ENABLE_DEBUG_ENDPOINTS=false

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500
# false = keep only extracted text + vectors; true = also keep one copy of each original file
STORE_UPLOADS=false

# ---------------------------------------------------------------- chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------------------------------------------------------------- embeddings
# sentence_transformers (default, semantic, downloads ~90 MB once) or hashing (offline, lexical)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------- retrieval
TOP_K=5
# Leave empty to use the per-embedder default (0.30 for sentence_transformers, 0.12 for hashing).
MIN_RELEVANCE_SCORE=
MAX_CONTEXT_CHARS=6000

# ---------------------------------------------------------------- answer generation
# ollama (local, default) | openai_compatible (hosted or local server) | extractive (no LLM)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=120

# Ollama: install from https://ollama.com, then `ollama pull llama3.2:3b`
OLLAMA_BASE_URL=http://localhost:11434
# Used instead of OLLAMA_BASE_URL when running with Docker Compose:
#   http://host.docker.internal:11434  -> Ollama installed on the host (default)
#   http://ollama:11434                -> bundled container (docker compose --profile ollama up)
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio, vLLM, ...).
# NOTE: with a hosted service, your questions and retrieved document excerpts are sent to it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------- frontend
API_URL=http://localhost:8000
